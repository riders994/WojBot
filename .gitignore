# Secrets / environment
.env
creds/set_creds.sh
sql_config.yml

# Generated SQL manager artifacts (keep the .sql source files, ignore the state)
sql/manager.log.json
sql/queries/_queries.json

# Elo engine generated state (written under resources/ by elo-system)
resources/anon/
resources/ratings/

# Live configuration. The bot writes to these at runtime -- server settings,
# league bindings, every season it scrapes -- so tracking them made the running
# copy diverge from git, and an update touching one stopped the Pi updating.
# Only the *.example.* templates are tracked; copy one to start a file.
resources/configs/**
!resources/configs/*.example.*

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Logs & data
*.log
*.csv

# Editors
.idea/

# Restart marker: written by /restart, consumed by the next start.
resources/state/
