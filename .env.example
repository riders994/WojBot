# Copy to .env and fill in. .env is gitignored.

# Required: your Discord bot token (Discord Developer Portal > Bot > Token).
DISCORD_TOKEN=

# Optional: a guild (server) ID to develop against. Commands always sync
# globally, which is what reaches every server but takes ~1h to propagate; set
# this and they are also synced to that one guild, where they appear at once.
# Only worth setting for a guild you are actively working in: the guild copy is
# a second registration of each command rather than a replacement, so that guild
# may list a command twice until the copies are cleared.
DISCORD_GUILD_ID=

# Optional: logging verbosity (DEBUG, INFO, WARNING, ERROR). Defaults to INFO.
LOG_LEVEL=INFO

# --- Database (optional) ---------------------------------------------------
# One shared Postgres warehouse holds every league; queries filter by league_id.
# Leave the whole section blank to run without database features — /rumor and
# everything under /commish db will be off, the rest of the bot works.
#
# Give the connection in ONE of two ways. SQL_CONN_URI is checked first and
# wins if it is set; only if it is empty are the discrete fields below read.

# 1. A whole connection string (libpq URI or key=value DSN). Use this when you
#    need options the fields can't express — sslmode, connect_timeout, a Unix
#    socket path. Remember that a password containing : / @ ? or # has to be
#    percent-encoded here.
# SQL_CONN_URI=postgresql://user:password@host:5432/wojbot

# 2. Or the pieces, which the bot assembles into the URI above. Easier to edit,
#    and the password is escaped for you, so it can contain anything.
#    SQL_HOST, SQL_USER and SQL_DBNAME are required; SQL_PORT defaults to 5432
#    and SQL_PASSWORD may be empty for peer or trust auth. Setting some but not
#    all of the required ones is an error rather than a silent fallback.
# SQL_HOST=localhost
# SQL_PORT=5432
# SQL_USER=
# SQL_PASSWORD=
# SQL_DBNAME=wojbot_db
