# Copy to .env and fill in. .env is gitignored.

# Required: your Discord bot token (Discord Developer Portal > Bot > Token).
DISCORD_TOKEN=

# Optional: a guild (server) ID. When set, slash commands sync to that guild
# instantly — ideal for development. Leave blank for global sync (~1h to propagate).
DISCORD_GUILD_ID=

# Optional: logging verbosity (DEBUG, INFO, WARNING, ERROR). Defaults to INFO.
LOG_LEVEL=INFO

# Optional: Postgres connection string for the SQL cog (libpq URI or key=value
# DSN). One shared warehouse holds all leagues; queries filter by league_id.
# Leave blank to run without database features.
# SQL_CONN_URI=postgresql://user:password@host:5432/wojbot
