# Copy to .env and fill in. .env is gitignored.

# Required: your Discord bot token (Discord Developer Portal > Bot > Token).
DISCORD_TOKEN=

# Optional: a guild (server) ID. When set, slash commands sync to that guild
# instantly — ideal for development. Leave blank for global sync (~1h to propagate).
DISCORD_GUILD_ID=

# Optional: logging verbosity (DEBUG, INFO, WARNING, ERROR). Defaults to INFO.
LOG_LEVEL=INFO

# Optional: remote Postgres DSN for authoritative league/fact data. Not used yet
# (the SQL data source lands with the commish/elo cogs). Requires the postgres
# extra: pip install -e '.[postgres]'
# DATABASE_URL=postgresql://user:pass@host:5432/wojbot
